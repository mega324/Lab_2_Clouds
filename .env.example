# === Keycloak Configuration ===
# Internal Docker network URL (не менять, если работаете через docker-compose)
KEYCLOAK_URL='https://keycloak:8443'

# === PostgreSQL ===
# Пароль для PostgreSQL — замените на свой
POSTGRES_PASSWORD='your_postgres_password_here'

# === Keycloak Admin ===
# Пароль администратора Keycloak — замените на свой
KEYCLOAK_ADMIN_PASSWORD='your_admin_password_here'

# === Client Credentials (inference-client) ===
# Client ID — не менять (должен совпадать с Keycloak)
CLIENT_ID='inference-client'

# Client Secret — замените на свой из Keycloak UI (Clients → inference-client → Credentials)
CLIENT_SECRET='your_client_secret_here'
